<Window x:Class="XIVLauncher.Windows.DeviceIdProfileManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="机器码配置管理" Height="500" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="新建配置"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    Click="NewProfileButton_Click"
                    Margin="0,0,10,0"/>
            <Button Content="删除选中"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    Click="DeleteProfileButton_Click"
                    Margin="0,0,10,0"/>
            <Button Content="应用到当前"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    Click="ApplyProfileButton_Click"
                    Margin="0,0,10,0"/>
            <Button Content="获取当前机器码"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    Click="GetCurrentDeviceIdButton_Click"
                    Margin="0,0,10,0"/>
        </StackPanel>

        <!-- 配置表格 -->
        <DataGrid Grid.Row="1"
                  x:Name="ProfileDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="All"
                  CellEditEnding="ProfileDataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="配置名称" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="MAC地址(MD5)" Binding="{Binding MacAddress}" Width="180"/>
                <DataGridTextColumn Header="CPU ID(MD5)" Binding="{Binding CpuId}" Width="180"/>
                <DataGridTextColumn Header="磁盘序列号(MD5)" Binding="{Binding DiskSerial}" Width="180"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    Click="SaveButton_Click"
                    Margin="0,0,10,0"/>
            <Button Content="关闭"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
