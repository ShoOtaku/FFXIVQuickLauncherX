<Window x:Class="XIVLauncher.Windows.AccountNetworkSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="账号网络配置" Height="420" Width="560" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/dalamud_icon.ico" ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Medium">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="当前账号:" Foreground="DarkGray" Margin="0,0,6,0"/>
            <TextBlock x:Name="AccountNameTextBlock" Foreground="Black" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <GroupBox Header="机器码配置" Margin="0,0,0,12">
                <StackPanel Margin="10">
                    <CheckBox x:Name="UseGlobalDeviceIdCheckBox"
                              Content="使用全局机器码设置"
                              Margin="0,0,0,6"
                              Checked="UseGlobalDeviceIdCheckBox_OnChanged"
                              Unchecked="UseGlobalDeviceIdCheckBox_OnChanged"/>
                    <StackPanel x:Name="DeviceIdProfilePanel" Margin="20,0,0,0">
                        <TextBlock Text="选择机器码配置:" Foreground="DarkGray" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DeviceIdProfileComboBox" Width="260" DisplayMemberPath="Name"/>
                        <TextBlock x:Name="DeviceIdProfileHintTextBlock"
                                   Text="暂无机器码配置，请先在高级设置中创建。"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="代理配置">
                <StackPanel Margin="10">
                    <CheckBox x:Name="UseGlobalProxyCheckBox"
                              Content="使用全局代理设置"
                              Margin="0,0,0,6"
                              Checked="UseGlobalProxyCheckBox_OnChanged"
                              Unchecked="UseGlobalProxyCheckBox_OnChanged"/>
                    <StackPanel x:Name="ProxyProfilePanel" Margin="20,0,0,0">
                        <TextBlock Text="选择代理配置:" Foreground="DarkGray" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ProxyProfileComboBox" Width="260" DisplayMemberPath="Name"/>
                        <TextBlock x:Name="ProxyProfileHintTextBlock"
                                   Text="暂无代理配置，请先在高级设置中创建。"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="保存"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    Click="SaveButton_Click"
                    Margin="0,0,10,0"/>
            <Button Content="关闭"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
